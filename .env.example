# ---- Shared (client + server) ----
# Copy to .env and adjust. Never commit .env with real values.

# Game server URL the browser connects to (WSS in production).
# Dev default: ws://localhost:2567
SERVER_URL=ws://localhost:2567

# Where "Reserve on Tesla" points. Set to Tesla's official Roadster page.
RESERVE_URL=

# Optional owner referral link. Only set if you legally own the referral
# programme link. The button uses it automatically and marks the link
# rel="sponsored" when present (spec 11.2).
REFERRAL_URL=

# Max players per room (default from config/rooms.json: 20).
MAX_PLAYERS_PER_ROOM=20

# Server process
PORT=2567
NODE_ENV=development

# Comma-separated allowed origins for the WebSocket endpoint (spec 13).
# Leave empty in production to disable the connection from other sites.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Privacy-friendly analytics endpoint (e.g. self-hosted Plausible), optional.
ANALYTICS_ENDPOINT=
